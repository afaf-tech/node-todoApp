<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0f17" />
    <title>Todo — a calm task list</title>
    <link rel="icon" href="/assets/logo.png" type="image/png" />
    <script src="/assets/theme.js"></script>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="/assets/app.js" defer></script>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <span class="orb orb-a"></span>
      <span class="orb orb-b"></span>
      <span class="orb orb-c"></span>
    </div>

    <main class="shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Todo home">
          <span class="brand-mark">
            <img src="/assets/logo.png" alt="" width="49" height="25" />
          </span>
          <span class="brand-name">todo</span>
        </a>

        <button
          id="theme-toggle"
          class="icon-button"
          type="button"
          aria-label="Switch to light theme"
          title="Switch theme"
        >
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path
              d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            />
          </svg>
          <svg
            class="icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
        </button>
      </header>

      <section class="intro">
        <p class="date" id="today-date"></p>
        <h1>What's on your plate?</h1>
        <p class="intro-copy">
          A small list for a clearer head. Add a task, check it off, move on.
        </p>
      </section>

      <section class="card" aria-label="Todo list">
        <form id="todo-form" class="composer" autocomplete="off">
          <label class="sr-only" for="item">New todo</label>
          <span class="composer-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
          <input
            id="item"
            name="item"
            type="text"
            placeholder="Add a new task..."
            maxlength="200"
            required
          />
          <button class="add-button" type="submit">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
            <span>Add</span>
          </button>
        </form>

        <div class="toolbar">
          <div class="filters" role="group" aria-label="Filter tasks">
            <button
              type="button"
              class="filter is-active"
              data-filter="all"
              aria-pressed="true"
            >
              All <span class="filter-count" data-count="all"><%= todos.length %></span>
            </button>
            <button
              type="button"
              class="filter"
              data-filter="active"
              aria-pressed="false"
            >
              Active <span class="filter-count" data-count="active"><%= todos.filter((todo) => !todo.completed).length %></span>
            </button>
            <button
              type="button"
              class="filter"
              data-filter="completed"
              aria-pressed="false"
            >
              Done <span class="filter-count" data-count="completed"><%= todos.filter((todo) => todo.completed).length %></span>
            </button>
          </div>
          <button id="clear-completed" class="clear-button" type="button" hidden>
            Clear done
          </button>
        </div>

        <div class="progress-block">
          <div class="progress-copy">
            <span id="progress-label">No tasks yet</span>
            <span id="progress-percent">0%</span>
          </div>
          <div
            id="progress-track"
            class="progress-track"
            role="progressbar"
            aria-label="Tasks completed"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <span id="progress-fill" class="progress-fill"></span>
          </div>
        </div>

        <ul id="todo-list" class="todo-list">
          <% todos.forEach((todo) => { %>
          <li class="todo<%= todo.completed ? ' is-done' : '' %>" data-id="<%= todo.id %>">
            <span class="check">
              <input
                class="toggle"
                type="checkbox"
                aria-label="Mark <%= todo.item %> as <%= todo.completed ? 'not done' : 'done' %>"
                <%= todo.completed ? 'checked' : '' %>
              />
              <label class="checkmark">
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m3.5 8.5 3 3 6-7" />
                </svg>
              </label>
            </span>

            <span
              class="todo-text"
              title="Double-click to edit"
            ><%= todo.item %></span>

            <span class="row-actions">
              <button
                class="row-action edit"
                type="button"
                aria-label="Edit <%= todo.item %>"
                title="Edit task"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m4 20 4.4-1.1L19 8.3a2.1 2.1 0 0 0-3-3L5.4 15.9 4 20Z" />
                  <path d="m13.5 6.5 3 3" />
                </svg>
              </button>
              <button
                class="row-action delete"
                type="button"
                aria-label="Delete <%= todo.item %>"
                title="Delete task"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m2 0v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7m3 4v6m4-6v6" />
                </svg>
              </button>
            </span>
          </li>
          <% }) %>
        </ul>

        <div
          id="empty"
          class="empty"
          <%= todos.length ? 'hidden' : '' %>
        >
          <span class="empty-art" aria-hidden="true">
            <svg
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="14" y="12" width="36" height="42" rx="8" opacity="0.35" />
              <path d="M24 13h16" opacity="0.55" />
              <path d="m23 33 6 6 13-14" />
            </svg>
          </span>
          <p class="empty-title" id="empty-title">Your list is clear</p>
          <p class="empty-copy" id="empty-copy">
            Add your first task above to get started.
          </p>
        </div>

        <footer class="card-footer">
          <span><kbd>/</kbd> focus</span>
          <span><kbd>Enter</kbd> add</span>
          <span><kbd>Esc</kbd> clear</span>
        </footer>

        <noscript>
          <p class="no-js">
            JavaScript is required to add, complete and delete tasks.
          </p>
        </noscript>
      </section>
    </main>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <template id="todo-template">
      <li class="todo">
        <span class="check">
          <input class="toggle" type="checkbox" />
          <label class="checkmark">
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3.5 8.5 3 3 6-7" />
            </svg>
          </label>
        </span>

        <span class="todo-text" title="Double-click to edit"></span>

        <span class="row-actions">
          <button class="row-action edit" type="button" title="Edit task">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m4 20 4.4-1.1L19 8.3a2.1 2.1 0 0 0-3-3L5.4 15.9 4 20Z" />
              <path d="m13.5 6.5 3 3" />
            </svg>
          </button>
          <button class="row-action delete" type="button" title="Delete task">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m2 0v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7m3 4v6m4-6v6" />
            </svg>
          </button>
        </span>
      </li>
    </template>
  </body>
</html>
